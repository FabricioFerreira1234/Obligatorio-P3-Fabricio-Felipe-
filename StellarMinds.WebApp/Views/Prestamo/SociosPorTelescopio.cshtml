@model StellarMinds.WebApp.Models.SociosPorTelescopioViewModel
@{
    ViewData["Title"] = "Socios por Telescopio";
}

<h1>Socios por Telescopio</h1>
<p class="text-muted">Seleccioná un telescopio y se listan todos los socios que lo solicitaron en préstamo (sin repetir).</p>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="SociosPorTelescopio" method="get" class="row g-3 align-items-end mb-4">
    <div class="col-auto">
        <label for="telescopioId" class="form-label">Telescopio</label>
        <select id="telescopioId" name="telescopioId" class="form-control">
            <option value="">-- Seleccione un telescopio --</option>
            @foreach (var t in Model.Telescopios)
            {
                <option value="@t.Id" selected="@(t.Id == Model.TelescopioId)">@t.Marca @t.Modelo</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Listar socios</button>
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</form>

@if (Model.Busco)
{
    if (Model.Socios.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Socios)
                {
                    <tr>
                        <td>@s.Nombre</td>
                        <td>@s.Apellido</td>
                        <td>@s.Email</td>
                        <td>@s.Telefono</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">Ningún socio solicitó este telescopio en préstamo.</div>
    }
}
