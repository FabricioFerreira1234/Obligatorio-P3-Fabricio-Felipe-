@model StellarMinds.WebApp.Models.Api.AltaCamaraModel
@{
    ViewData["Title"] = "Alta Cámara";
}

<h1>Alta Cámara</h1>
<div class="row">
    <div class="col-md-6">
        <form asp-action="CreateCamara">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }
            <div class="form-group"><label asp-for="Marca">Marca</label><input asp-for="Marca" class="form-control" /></div>
            <div class="form-group"><label asp-for="Modelo">Modelo</label><input asp-for="Modelo" class="form-control" /></div>
            <div class="form-group"><label asp-for="Cantidad">Cantidad</label><input asp-for="Cantidad" class="form-control" /></div>
            <div class="form-group">
                <label asp-for="Sensor">Tipo de Sensor</label>
                <select asp-for="Sensor" class="form-control"
                        asp-items="Html.GetEnumSelectList<StellarMinds.WebApp.Models.Api.TipoSensor>()">
                    <option value="">-- Seleccionar --</option>
                </select>
            </div>
            <div class="form-group"><label asp-for="Resolucion">Resolución (µm)</label><input asp-for="Resolucion" class="form-control" /></div>
            <div class="form-group"><label asp-for="PixelSize">Tamaño de Píxel (µm)</label><input asp-for="PixelSize" class="form-control" /></div>
            <button type="submit" class="btn btn-primary mt-3">Guardar</button>
            <a asp-action="Create" class="btn btn-secondary mt-3">Volver</a>
        </form>
    </div></div>