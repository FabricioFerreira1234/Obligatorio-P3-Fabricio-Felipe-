@model StellarMinds.WebApp.Models.Api.AltaOcularModel
<h1>Editar Ocular</h1>
<div class="row">
    <div class="col-md-6">
        <form asp-action="EditOcular">
            <input type="hidden" asp-for="Id" />
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }
            <div class="form-group"><label asp-for="Marca">Marca</label><input asp-for="Marca" class="form-control" /></div>
            <div class="form-group"><label asp-for="Modelo">Modelo</label><input asp-for="Modelo" class="form-control" /></div>
            <div class="form-group"><label asp-for="Cantidad">Cantidad</label><input asp-for="Cantidad" class="form-control" /></div>
            <div class="form-group"><label asp-for="Diametro">Diámetro (mm)</label><input asp-for="Diametro" class="form-control" /></div>
            <div class="form-group"><label asp-for="AnguloVisual">Ángulo Visual (°)</label><input asp-for="AnguloVisual" class="form-control" /></div>
            <button type="submit" class="btn btn-primary mt-3">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-secondary mt-3">Cancelar</a>
        </form>
    </div></div>