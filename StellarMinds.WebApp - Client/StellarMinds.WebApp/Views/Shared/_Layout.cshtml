<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StellarMinds.WebApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StellarMinds.WebApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">StellarMinds.WebApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                            {
                                @* RF10 - Ranking de objetos celestes: disponible para cualquier rol. *@
                                <li class="nav-item">
                                    <a asp-controller="Ranking" asp-action="Index" class="btn btn-outline-primary me-2">
                                        Ranking de Objetos
                                    </a>
                                </li>

                                @if (User.FindFirst("TipoUsuario")?.Value == "Administrador")
                                {

                                    
                                    <li class="nav-item">
                                        <a asp-controller="Equipo" asp-action="Index" class="btn btn-primary me-2">
                                            Equipos
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a asp-controller="Usuario" asp-action="Index" class="btn btn-primary me-2">
                                            Usuarios
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a asp-controller="Prestamo" asp-action="SociosPorTelescopio" class="btn btn-primary me-2">
                                            Socios por Telescopio
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a asp-controller="Auditoria" asp-action="Index" class="btn btn-primary me-2">
                                            Auditoría de Préstamos
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a asp-controller="Login" asp-action="Logout" class="btn btn-outline-danger">
                                            Cerrar Sesión
                                        </a>
                                    </li>
                                }
                                @if (User.FindFirst("TipoUsuario")?.Value == "Coordinador")
                                {
                                    <li class="nav-item">
                                        <a asp-controller="Prestamo" asp-action="Create" class="btn btn-primary me-2">
                                            Nuevo Préstamo
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a asp-controller="Prestamo" asp-action="Devolucion" class="btn btn-primary me-2">
                                            Devolución
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a asp-controller="Prestamo" asp-action="SociosPorTelescopio" class="btn btn-primary me-2">
                                            Socios por Telescopio
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a asp-controller="Login" asp-action="Logout" class="btn btn-outline-danger">
                                            Cerrar Sesión
                                        </a>
                                    </li>
                                }
                                @if (User.FindFirst("TipoUsuario")?.Value == "Socio")
                                {
                                <li class="nav-item">
                                    <a asp-controller="Observacion" asp-action="Create" class="btn btn-primary me-2">
                                        Nueva Observación
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Prestamo" asp-action="MisPrestamos" class="btn btn-primary me-2">
                                        Mis Préstamos
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Login" asp-action="Logout" class="btn btn-outline-danger">
                                        Cerrar Sesión
                                    </a>
                                </li>
                                }
                            }
                            else
                            {
                                // No logueado: solo muestra Login
                                <li class="nav-item">
                                    <a asp-controller="Login" asp-action="Index" class="btn btn-primary">
                                        Iniciar Sesión
                                    </a>
                                </li>
                            }
                        </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - StellarMinds.WebApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>