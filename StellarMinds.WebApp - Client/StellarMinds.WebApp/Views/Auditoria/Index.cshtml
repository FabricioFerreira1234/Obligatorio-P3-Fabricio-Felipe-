@model StellarMinds.WebApp.Models.AuditoriaIndexViewModel
@{
    ViewData["Title"] = "Auditoría de Préstamos";
}

<h1>Auditoría de Préstamos</h1>
<p class="text-muted">Préstamos realizados por coordinadores. Filtrá por coordinador y abrí la auditoría de cada préstamo.</p>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="Index" method="get" class="row g-3 align-items-end mb-4">
    <div class="col-auto">
        <label for="coordinadorId" class="form-label">Coordinador</label>
        <select id="coordinadorId" name="coordinadorId" class="form-control">
            <option value="">-- Todos los coordinadores --</option>
            @foreach (var c in Model.Coordinadores)
            {
                <option value="@c.Id" selected="@(c.Id == Model.CoordinadorId)">@c.NombreCompleto.Nombre @c.NombreCompleto.Apellido</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</form>

@if (Model.Prestamos.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>#</th>
                <th>Socio</th>
                <th>Coordinador</th>
                <th>Telescopio</th>
                <th>Desde</th>
                <th>Hasta</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Prestamos)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.Socio</td>
                    <td>@p.Coordinador</td>
                    <td>@p.Telescopio</td>
                    <td>@p.FechaInicio.ToString("dd/MM/yyyy")</td>
                    <td>@p.FechaFin.ToString("dd/MM/yyyy")</td>
                    <td>
                        @p.Estado
                        @if (p.Atrasado)
                        {
                            <span class="badge bg-danger">Atrasado</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Auditoria" asp-route-prestamoId="@p.Id" class="btn btn-sm btn-outline-primary">Ver auditoría</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No hay préstamos realizados por coordinadores para el filtro seleccionado.</div>
}
