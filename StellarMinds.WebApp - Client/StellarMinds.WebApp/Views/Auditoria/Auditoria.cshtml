@model StellarMinds.WebApp.Models.AuditoriaPrestamoViewModel
@{
    ViewData["Title"] = "Auditoría del Préstamo";
}

<h1>Auditoría del Préstamo #@Model.PrestamoId</h1>
<p class="text-muted">Acciones registradas sobre el préstamo (préstamo y devolución), con fecha y coordinador que las realizó.</p>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (Model.Items.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Acción</th>
                <th>Fecha y hora</th>
                <th>Coordinador</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in Model.Items)
            {
                <tr>
                    <td>@(i.Accion == "PRESTAMO" ? "Préstamo" : "Devolución")</td>
                    <td>@i.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@i.Coordinador</td>
                    <td>@i.CoordinadorEmail</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">Este préstamo no tiene acciones auditadas.</div>
}

<div class="mt-3">
    <a asp-action="Detalle" asp-route-prestamoId="@Model.PrestamoId" class="btn btn-primary">Ver detalles del préstamo</a>
    <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
</div>
