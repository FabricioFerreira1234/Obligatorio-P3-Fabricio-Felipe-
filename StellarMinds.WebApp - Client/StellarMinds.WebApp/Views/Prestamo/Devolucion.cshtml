@model StellarMinds.WebApp.Models.PrestamoDevolucionViewModel
@{
    ViewData["Title"] = "Devolución de Préstamo";
}

<h1>Devolución de Préstamo</h1>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Devolucion" method="get" class="mb-4">
    <div class="form-group mb-3">
        <label for="socioId">Socio que devuelve</label>
        <select id="socioId" name="socioId" class="form-control">
            <option value="">-- Seleccione un socio --</option>
            @foreach (var s in Model.Socios)
            {
                <option value="@s.Id" selected="@(s.Id == Model.SocioId)">
                    @s.NombreCompleto?.Nombre @s.NombreCompleto?.Apellido (@s.Email)
                </option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Listar préstamos</button>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Volver</a>
</form>

@if (Model.BuscoSocio)
{
    if (Model.Prestamos.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Telescopio</th>
                    <th>Montura</th>
                    <th>Equipo visual</th>
                    <th>Inicio</th>
                    <th>Fin</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Prestamos)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.Telescopio</td>
                        <td>@p.Montura</td>
                        <td>@(p.Visual ?? "-")</td>
                        <td>@p.FechaInicio.ToShortDateString()</td>
                        <td>@p.FechaFin.ToShortDateString()</td>
                        <td>
                            @p.Estado
                            @if (p.Atrasado)
                            {
                                <span class="badge bg-warning text-dark">Atrasado</span>
                            }
                        </td>
                        <td>
                            <form asp-action="Devolver" method="post">
                                <input type="hidden" name="prestamoId" value="@p.Id" />
                                <input type="hidden" name="socioId" value="@Model.SocioId" />
                                <button type="submit" class="btn btn-success btn-sm">Devolver</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">El socio seleccionado no tiene préstamos pendientes de devolución.</div>
    }
}
