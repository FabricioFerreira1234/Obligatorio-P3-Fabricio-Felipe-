@model StellarMinds.WebApp.Models.MisPrestamosViewModel
@{
    ViewData["Title"] = "Mis Préstamos";
    string[] meses = { "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
                       "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
}

<h1>Mis Préstamos</h1>
<p class="text-muted">Listado de tus préstamos realizados en el mes y año seleccionados.</p>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="MisPrestamos" method="get" class="row g-3 align-items-end mb-4">
    <div class="col-auto">
        <label for="mes" class="form-label">Mes</label>
        <select id="mes" name="mes" class="form-control">
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(m == Model.Mes)">@meses[m - 1]</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label for="anio" class="form-label">Año</label>
        <input id="anio" name="anio" type="number" class="form-control" value="@Model.Anio" min="2000" max="2100" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</form>

@if (Model.Busco)
{
    if (Model.Prestamos.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Telescopio</th>
                    <th>Montura</th>
                    <th>Equipo visual</th>
                    <th>Inicio</th>
                    <th>Fin</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Prestamos)
                {
                    <tr class="@(p.Atrasado ? "table-warning" : "")">
                        <td>@p.Id</td>
                        <td>@p.Telescopio</td>
                        <td>@p.Montura</td>
                        <td>@(p.Visual ?? "-")</td>
                        <td>@p.FechaInicio.ToShortDateString()</td>
                        <td>@p.FechaFin.ToShortDateString()</td>
                        <td>
                            @p.Estado
                            @if (p.Atrasado)
                            {
                                <span class="badge bg-danger">Atrasado</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            No existen préstamos realizados en @meses[Model.Mes - 1] de @Model.Anio.
        </div>
    }
}
